{
  "name": "erp-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST multiempresa del ERP (Node.js + Express + MongoDB Atlas)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "build": "echo 'No build step required for Express backend'",
    "migrate:single-company": "echo 'No migration required'",
    "dev": "nodemon src/server.js",
    "seed": "node src/scripts/seed.js",
    "migrate:master-data": "node src/scripts/migrate-master-data.js",
    "seed:sales": "node src/scripts/seed-sales.js",
    "seed:sales:remove": "node src/scripts/remove-demo-sales.js",
    "indexes": "node ../database/indexes/apply-indexes.js",
    "email:test": "node src/scripts/email-test.js",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.2",
    "mongoose": "^8.6.0",
    "pdfkit": "^0.20.2",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
