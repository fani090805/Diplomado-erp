# ─────────────────────────────────────────────────────────────────────────────
# FAI Solution ERP — variables de entorno (EJEMPLO, sin valores reales).
# Copia este archivo a .env en la raíz del proyecto y llena tus valores.
# Nunca subas .env al repositorio. Los scripts demo leen además backend/.env
# (basta con la línea MONGO_URI).
# ─────────────────────────────────────────────────────────────────────────────

# --- Servidor ---------------------------------------------------------------
# development | production | test
NODE_ENV=development
# Puerto de la API
PORT=4000
# Prefijo de todas las rutas de la API
API_PREFIX=/api/v1
# Nivel de log: fatal | error | warn | info | debug
LOG_LEVEL=info

# --- Base de datos ----------------------------------------------------------
# Cadena de conexión de MongoDB Atlas (único nombre válido: MONGO_URI)
MONGO_URI=mongodb+srv://usuario:contrasena@cluster0.ejemplo.mongodb.net/erp?retryWrites=true&w=majority

# --- Autenticación (JWT) ----------------------------------------------------
# En producción: 32+ caracteres aleatorios y distintos entre sí
JWT_ACCESS_SECRET=cambie-este-secreto-de-acceso-por-uno-largo
JWT_REFRESH_SECRET=cambie-este-secreto-de-renovacion-por-otro-largo
# Vigencia del token de acceso y del de renovación
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- CORS -------------------------------------------------------------------
# Orígenes permitidos para la web, separados por coma
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Registro y semilla -----------------------------------------------------
# false = desactiva el registro público y las solicitudes de alta de empresas
ALLOW_PUBLIC_SIGNUP=true
# false = no ejecutar la semilla (roles, empresa y admin demo) al arrancar la API
SEED_ON_START=true
# Administrador demo que crea/sincroniza la semilla
SEED_ADMIN_EMAIL=admin@demo.example.com
SEED_ADMIN_PASSWORD=Cambie-Esta-Clave-123

# --- Correo -----------------------------------------------------------------
# Proveedor de correo: resend | brevo (sin API key o sin remitente no se envían correos)
EMAIL_PROVIDER=resend
# API key de Resend (si EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# API key de Brevo (si EMAIL_PROVIDER=brevo)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx
# Remitente de los correos (dominio verificado en el proveedor)
EMAIL_FROM=no-responder@ejemplo.mx
# Nombre visible del remitente
EMAIL_FROM_NAME=FAI Solution ERP
# Opcional: redirige todos los correos a esta dirección mientras no haya dominio verificado.
# Al verificar el dominio, elimina esta variable para enviar a los destinatarios reales.
EMAIL_REDIRECT_TO=
# URL pública de la web: se usa en los botones y enlaces de los correos
APP_URL=http://localhost:8081
# true = avisar por correo a cada usuario cuando inicia sesión
LOGIN_NOTIFICATIONS=false
# Correo extra que recibe el aviso de nuevas solicitudes de empresa (además de los super admin)
PLATFORM_NOTIFY_EMAIL=plataforma@ejemplo.mx

# --- Frontend (Expo) --------------------------------------------------------
# URL de la API que usa la web/app. Expo la lee de frontend/.env o del entorno de build.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
