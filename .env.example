# General
NODE_ENV=development
PORT=4000
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-random-secret-of-at-least-32-chars
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/erp-dev?retryWrites=true&w=majority

# Client
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
